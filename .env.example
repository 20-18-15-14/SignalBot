OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql+psycopg://signal:signal@postgres:5432/signal_osint
SIGNAL_API_BASE_URL=http://signal-cli-rest-api:8080
SIGNAL_BOT_NUMBER=+15550000000
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_GROUP_AUTO_REPLY=false
ENABLE_DM_EPHEMERAL_MEMORY=true
ENABLE_DM_STORAGE_MINIMAL=true
AUTH_MEMBERSHIP_TTL_DAYS=30
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15
OPENAI_REQUEST_TIMEOUT_SECONDS=45
SIGNAL_WEBHOOK_SECRET=changeme
ADMIN_API_TOKEN=changeme
ADMIN_API_TOKENS=
EMBEDDING_DIMENSIONS=1536
GROUP_AUTO_REPLY_ONLY_AUTHORIZED=true
GROUP_AUTO_REPLY_REQUIRE_QUESTION=false
DM_RATE_LIMIT_COUNT=5
DM_RATE_LIMIT_WINDOW_SECONDS=60
GROUP_RATE_LIMIT_COUNT=2
GROUP_RATE_LIMIT_WINDOW_SECONDS=60
CHUNK_MAX_CHARS=3500
CHUNK_MAX_MESSAGES=50
KNOWLEDGE_CHUNK_MAX_CHARS=2000
INGESTION_WORKER_ENABLED=true
INGESTION_WORKER_POLL_SECONDS=3
INGESTION_WORKER_BATCH_SIZE=5
SIGNAL_CLI_IMAGE=bbernhard/signal-cli-rest-api:latest
